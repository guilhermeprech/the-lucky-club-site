{
  "name": "the-lucky-club-site",
  "private": true,
  "description": "Atalhos para rodar o app Next.js em ./web a partir da raiz. Sem dependências próprias.",
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "npm --prefix web run dev --",
    "build": "npm --prefix web run build --",
